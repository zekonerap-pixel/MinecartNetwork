<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MinecartNetwork</AssemblyName>
    <RootNamespace>MinecartNetwork</RootNamespace>
    <EnableModDeploy>true</EnableModDeploy>
    <EnableHarmony>true</EnableHarmony>
    <ModFolderName>MinecartNetwork</ModFolderName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure nested station sprite sets are present in the compiled/deployed mod. -->
    <None Update="assets/**/*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
